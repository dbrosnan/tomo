# Postgres connection string (any Postgres 14+ works locally)
DATABASE_URL=postgres://tomo:tomo@localhost:5432/tomo

# Boson AI API key — https://docs.boson.ai/set-up-your-account
# Used server-side only, to mint short-lived Higgs Realtime client secrets.
BOSON_API_KEY=

# Port the server listens on
PORT=8080
